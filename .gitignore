# Dependências
node_modules/
.venv/

# Variáveis de ambiente e segredos
.env
.env.*
!.env.example

# Documentos pedagógicos de consulta interna e rascunhos locais (não versionar)
Documentos_Consulta/
[Dd]ocumentos_[Cc]onsulta/
Documentos*/
