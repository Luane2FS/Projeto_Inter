override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Chaves SSH e Certificados
*.pem
*.key
*.pub
id_rsa*
id_ed25519*

# Logs
*.log
npm-debug.log*

# Estado local e segredos do Postman
.postman/
postman/collections/
postman/environments/
postman/globals/

