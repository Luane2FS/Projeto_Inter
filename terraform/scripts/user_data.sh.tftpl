#!/bin/bash
# ==============================================================================
# user_data.sh.tftpl - Script de Inicialização Automatizada da Instância EC2
# Renderizado pelo Terraform via templatefile
# Projeto Integrador: Capacita Computação em Nuvem
# ==============================================================================

set -euo pipefail

# Redirecionar todas as saídas para arquivo de log legível via SSH
exec > >(tee -a /var/log/user_data.log | logger -t user-data -s 2>/dev/console) 2>&1

echo "======================================================================"
echo "[INFO] Iniciando provisionamento automatizado da instância EC2..."
echo "[INFO] Projeto: ${project_name}"
echo "[INFO] Repositório Alvo: ${github_repo_url}"
echo "[INFO] Data e Hora: $(date)"
echo "======================================================================"

# 1. Atualizar repositórios e pacotes do sistema operacional (Amazon Linux 2023 / AL2)
echo "[INFO] 1/6 Atualizando repositórios e instalando dependências do sistema..."
if command -v dnf &> /dev/null; then
  dnf update -y
  dnf install -y --allowerasing docker git jq e2fsprogs nvme-cli
elif command -v amazon-linux-extras &> /dev/null; then
  yum update -y
  amazon-linux-extras install docker -y
  yum install -y git curl jq e2fsprogs
else
  yum update -y
  yum install -y docker git curl jq e2fsprogs
fi

# 2. Habilitar e iniciar o daemon do Docker
echo "[INFO] 2/6 Habilitando e inicializando serviço Docker..."
systemctl enable docker
systemctl start docker
usermod -aG docker ec2-user

# 3. Montar volume EBS dedicado e desacoplado para dados do MongoDB
echo "[INFO] 3/6 Localizando e montando volume EBS dedicado para o MongoDB..."
DATA_MOUNT="/mnt/mongo-data"
mkdir -p "$DATA_MOUNT"

# Aguarda o anexo do volume EBS pelo Terraform (procura disco secundário não-raiz)
EBS_DEVICE=""
for i in $(seq 1 30); do
  EBS_DEVICE=$(lsblk -dpno NAME | grep -v "nvme0n1" | head -n 1 || true)
  if [ -n "$EBS_DEVICE" ]; then
    echo "[INFO] Volume EBS persistente detectado: $EBS_DEVICE"
    break
  fi
  echo "[INFO] Aguardando anexo do volume EBS ($${i}/30)..."
  sleep 2
done

# Falha crítica obrigatória caso o disco EBS desacoplado não seja encontrado
# Impede terminantemente a execução do MongoDB no disco raiz efêmero da instância
if [ -z "$EBS_DEVICE" ]; then
  echo "======================================================================"
  echo "[FATAL] Falha crítica: Volume EBS desacoplado para o MongoDB não foi detectado."
  echo "[FATAL] A inicialização foi abortada para garantir a integridade dos dados e impedir o uso do disco raiz."
  echo "======================================================================"
  exit 1
fi

# Formata com ext4 apenas se for a primeira vez (sem sistema de arquivos existente)
if ! blkid "$EBS_DEVICE" > /dev/null 2>&1; then
  echo "[INFO] Formatando novo volume EBS ($EBS_DEVICE) com ext4..."
  mkfs.ext4 -m 1 "$EBS_DEVICE"
else
  echo "[INFO] Sistema de arquivos existente detectado em $EBS_DEVICE. Preservando dados anteriores do banco!"
fi

mount "$EBS_DEVICE" "$DATA_MOUNT"

# Restringe permissões: posse para UID:GID 999 (usuário mongodb do contêiner) e acesso restrito 0700
chown -R 999:999 "$DATA_MOUNT"
chmod 700 "$DATA_MOUNT"

UUID=$(blkid -s UUID -o value "$EBS_DEVICE")
if ! grep -q "$UUID" /etc/fstab; then
  echo "UUID=$UUID $DATA_MOUNT ext4 defaults,nofail 0 2" >> /etc/fstab
fi

# Vincula o diretório do volume nomeado do Docker ao volume EBS persistente
mkdir -p /var/lib/docker/volumes/saas-mongo-data/_data
mount --bind "$DATA_MOUNT" /var/lib/docker/volumes/saas-mongo-data/_data
chown -R 999:999 /var/lib/docker/volumes/saas-mongo-data/_data
chmod 700 /var/lib/docker/volumes/saas-mongo-data/_data
if ! grep -q "/var/lib/docker/volumes/saas-mongo-data/_data" /etc/fstab; then
  echo "$DATA_MOUNT /var/lib/docker/volumes/saas-mongo-data/_data none bind 0 0" >> /etc/fstab
fi
echo "[INFO] Volume EBS persistente desacoplado montado com sucesso e vinculado ao Docker com permissões restritas (0700, UID 999)."

# 4. Instalar o plugin Docker Compose v2 oficial
echo "[INFO] 4/6 Instalando Docker Compose v2..."
DOCKER_CONFIG="$${DOCKER_CONFIG:-/usr/local/lib/docker}"
mkdir -p "$DOCKER_CONFIG/cli-plugins"
ARCH="$(uname -m)"
curl -SL "https://github.com/docker/compose/releases/download/v2.29.2/docker-compose-linux-$${ARCH}" -o "$DOCKER_CONFIG/cli-plugins/docker-compose"
chmod +x "$DOCKER_CONFIG/cli-plugins/docker-compose"
ln -sf "$DOCKER_CONFIG/cli-plugins/docker-compose" /usr/bin/docker-compose

docker --version
docker compose version

# 5. Clonar o repositório oficial da aplicação
APP_DIR="/opt/projeto-inter"
echo "[INFO] 5/6 Preparando diretório da aplicação em $APP_DIR..."
mkdir -p "$APP_DIR"
cd "$APP_DIR"

echo "[INFO] Clonando repositório configurado no Terraform: ${github_repo_url}..."
if ! git clone "${github_repo_url}" repo; then
  echo "======================================================================"
  echo "[FATAL] Falha crítica: Não foi possível clonar o repositório ${github_repo_url}."
  echo "[FATAL] Verifique se a URL está acessível ou se o repositório requer autenticação."
  echo "======================================================================"
  exit 1
fi

cd repo

# Gerar JWT_SECRET criptográfica caso não tenha sido fornecida via ambiente
if [ ! -f .env ]; then
  echo "[INFO] Gerando chave JWT segura para execução inicial dos contêineres..."
  GEN_JWT_SECRET=$(head -c 32 /dev/urandom | xxd -ps -c 32 2>/dev/null || openssl rand -hex 32)
  (
    umask 077
    cat << EOF > .env
NODE_ENV=production
PORT=${app_port}
MONGO_URI=mongodb://mongodb:27017/saas
JWT_SECRET=$${GEN_JWT_SECRET}
RATE_LIMIT_STORE=mongodb
ALLOW_PUBLIC_MULTI_REGISTER=false
ALLOW_DIRECT_PLAN_CHANGE=false
CORS_ORIGIN=*
EOF
    chmod 600 .env
  )
  chown ec2-user:ec2-user .env
  echo "[INFO] Arquivo .env gerado com sucesso com segredo forte e permissões restritas (0600)."
fi

# Construir e inicializar contêineres em segundo plano
echo "[INFO] Construindo e inicializando contêineres oficiais via Docker Compose..."
docker compose up -d --build

echo "======================================================================"
echo "[INFO] Provisionamento concluído com sucesso!"
echo "[INFO] Verifique os contêineres com: docker compose ps"
echo "[INFO] Teste local na EC2: curl http://127.0.0.1:${app_port}/health"
echo "======================================================================"
